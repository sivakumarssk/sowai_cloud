# ════════════════════════════════════════════════════════════════════
# Sowsi Cloud — environment variables (server setup checklist)
#
# Copy to .env and fill in. On servers keep EVERYTHING in .env:
# the web app gives .env.local priority, but Prisma, the seed, the engine
# and scripts read .env only — two files drift apart.
#
# [required]  must be set or the feature fails
# [optional]  has a sensible default (shown in brackets)
# Money values are in paise (₹1 = 100).
# ════════════════════════════════════════════════════════════════════


# ── Core ─────────────────────────────────────────────────────────────

# [required] PostgreSQL connection string
DATABASE_URL=

# [required] Signs login sessions. 32+ random characters: openssl rand -hex 32
JWT_SECRET=

# [required] AES-256 key for stored passwords (SSH, Coolify). 64 hex chars: openssl rand -hex 32
#            BACK THIS UP — losing it makes every stored credential unreadable.
ENCRYPTION_KEY=

# [required] Public URL of the app, used in emails and redirects, e.g. https://sowsicloud.com
NEXT_PUBLIC_APP_URL=


# ── Google sign-in ───────────────────────────────────────────────────

# [optional] Google Cloud Console → APIs & Services → Credentials (OAuth client)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=


# ── Razorpay (payments + autopay) ────────────────────────────────────

# [required] Razorpay Dashboard → Account & Settings → API Keys
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# [required] Same value as RAZORPAY_KEY_ID (used by the checkout widget in the browser)
NEXT_PUBLIC_RAZORPAY_KEY_ID=

# [required] Secret of the webhook pointing to https://<domain>/api/payment/webhook
#            Events: payment.captured + all subscription.* events.
#            Without it autopay renewals and failed-payment handling don't work.
RAZORPAY_WEBHOOK_SECRET=


# ── Email (notifications) ────────────────────────────────────────────
# Microsoft 365 is used when all four MS_*/MAIL_FROM are set; otherwise
# Resend; otherwise emails are skipped with a warning.

# [required] Mailbox emails are sent from, e.g. info@sowsitechnologies.com
MAIL_FROM=
# [required] Entra ID app registration with the APPLICATION permission Mail.Send (admin-consented)
MS_TENANT_ID=
MS_CLIENT_ID=
MS_CLIENT_SECRET=

# [optional] Fallback provider, only used if Microsoft 365 isn't configured
RESEND_API_KEY=
EMAIL_FROM=

# [optional] Comma-separated admin alert recipients [all ADMIN users]
ADMIN_ALERT_EMAIL=


# ── Billing jobs ─────────────────────────────────────────────────────

# [required] Protects POST /api/cron/billing (call every 15 min with "Authorization: Bearer <value>").
#            openssl rand -hex 32
CRON_SECRET=


# ── Pricing page ─────────────────────────────────────────────────────

# [optional] Sales WhatsApp on the Dedicated tab: digits with country code, e.g. 919876543210 [email only]
NEXT_PUBLIC_SALES_WHATSAPP=


# ── Provisioning: Proxmox ────────────────────────────────────────────

# [required] "proxmox" = paid VPS orders create real containers; anything else = simulated [simulated]
PROVISIONER=

# [required] The Proxmox host
PROXMOX_HOST=
# [optional] [8006]
PROXMOX_PORT=
# [required] Node name as shown in Proxmox, e.g. sowsi-proxmox-01
PROXMOX_NODE=
# [required] API token: Datacenter → Permissions → API Tokens (same token must exist on every node)
PROXMOX_USER=
PROXMOX_TOKEN_ID=
PROXMOX_TOKEN_SECRET=
# [optional] "true" once the host has a real TLS certificate [false — self-signed accepted]
PROXMOX_VERIFY_TLS=

# [optional] Storage for container disks [local]
PROXMOX_STORAGE=
# [optional] Storage holding LXC templates [local]
PROXMOX_TEMPLATE_STORAGE=
# [optional] Routed container bridge created by scripts/proxmox-host-setup.sh [vmbr1]
PROXMOX_BRIDGE=
# [optional] Container features [nesting=1]
PROXMOX_LXC_FEATURES=
# [optional] Override the LXC template for an OS, e.g. PROXMOX_LXC_TEMPLATE_UBUNTU_22_04=ubuntu-22.04-standard_22.04-1_amd64.tar.zst
#            [built-in list for ubuntu-22.04, ubuntu-24.04, debian-12]
# PROXMOX_LXC_TEMPLATE_<OS>=

# [required] The node's routed IPv6 /64 without the trailing "::", e.g. 2a01:4f8:1c16:5f1d
PROXMOX_IPV6_SUBNET=
# [optional] Container gateways [172.31.1.1 / fe80::1]
PROXMOX_GATEWAY4=
PROXMOX_GATEWAY6=

# [required] Platform SSH key used for the first login into new containers.
#            Generate: ssh-keygen -t ed25519 -N "" -f ~/.ssh/sowsi_provisioning
PROVISIONING_SSH_PUBLIC_KEY=
# [required] Path to the private key on THIS server (or put the key itself in PROVISIONING_SSH_PRIVATE_KEY)
PROVISIONING_SSH_PRIVATE_KEY_PATH=
# [optional] Private key contents instead of a path (newlines as \n)
PROVISIONING_SSH_PRIVATE_KEY=


# ── Provisioning: Hetzner Cloud ──────────────────────────────────────

# [required] Hetzner Cloud Console → project → Security → API tokens (read & write)
HETZNER_API_TOKEN=
# [required] ID of the Proxmox host server (number in the Hetzner Console URL)
HETZNER_SERVER_ID=
# [optional] Location for new Floating IPs; must match the server [nbg1]
HETZNER_LOCATION=


# ── Resource engine (sowsi-mgmt-01, PM2 "sowsi-engine") ───────────────
# The engine also uses DATABASE_URL and the PROXMOX_* API settings above.
# Node addresses come from the database (registered by `npm run db:seed`).

# [optional] Monthly cost of the Proxmox host recorded by the seed, in paise [330000 = ₹3,300]
PROXMOX_NODE_MONTHLY_COST_PAISE=

# [optional] Poll intervals in seconds [30 / 30]
CONTAINER_POLL_SECONDS=
SERVER_POLL_SECONDS=

# [optional] Container RAM thresholds, % of the container's limit [75 / 85 / 95]
RAM_WARNING_PCT=
RAM_CRITICAL_PCT=
RAM_EMERGENCY_PCT=

# [optional] Container disk thresholds, % of the root disk [75 / 85 / 98]
DISK_WARNING_PCT=
DISK_CRITICAL_PCT=
DISK_FULL_PCT=

# [optional] CPU_HIGH fires when usage stays above CPU_ALERT_PCT for CPU_ALERT_DURATION seconds [85 / 300]
CPU_ALERT_PCT=
CPU_ALERT_DURATION=

# [optional] Physical server thresholds, % of capacity [70 / 80 / 90]
SERVER_WARNING_PCT=
SERVER_CRITICAL_PCT=
SERVER_EMERGENCY_PCT=
# [optional] SERVER_FULL when RAM or disk passes this % [85]
SERVER_FULL_PCT=
# [optional] SERVER_OVERLOADED when CPU stays above this % for this many seconds [90 / 600]
SERVER_CPU_OVERLOAD_PCT=
SERVER_CPU_OVERLOAD_DURATION=

# [optional] Points below a threshold before a level clears, stops alerts flapping [5]
ENGINE_HYSTERESIS_PCT=

# [optional] Free-pool space never handed out to containers, GB [20]
DISK_POOL_RESERVE_GB=
# [optional] Size of one /data expansion, GB [10]
DISK_EXPAND_CHUNK_GB=
# [optional] Hetzner Volume cost, paise per GB per month [530 = ₹5.30]
VOLUME_COST_PER_GB=
# [optional] Size of a Hetzner Volume the engine proposes buying, GB, 10–10240 [100 = ₹530/mo]
VOLUME_SIZE_GB=
# [optional] Placement: promised container RAM may reach a node's physical RAM × this [1 = no overcommit]
NODE_RAM_OVERCOMMIT=
# [optional] Size of one RAM increase, MB [512]
RAM_EXPAND_CHUNK_MB=
# [optional] RAM may be raised to at most plan × this; never lowered below the plan [2]
RAM_MAX_MULTIPLIER=

# ── Resource engine: what it may do on its own ──
# The stricter of ENGINE_MODE and the action's own setting wins.
# Anything over ENGINE_SPEND_CAP_PAISE in a month always needs admin approval.

# [optional] OBSERVE (log only) | ASSISTED (email admin to approve) | AUTO [OBSERVE]
ENGINE_MODE=
# [optional] Per action: AUTO | ASSISTED | MANUAL (recommend only) | OFF
# RAM scaling — free, instant [AUTO]
ENGINE_ACTION_RAM_SCALE=
# Disk expansion from the free pool / existing Volumes [ASSISTED]
ENGINE_ACTION_DISK_EXPAND=
# Buying a Hetzner Volume, ~₹530/mo [MANUAL]
ENGINE_ACTION_VOLUME_PURCHASE=
# Buying a new server, ~₹3,300/mo [MANUAL]
ENGINE_ACTION_SERVER_PURCHASE=
# Moving a client to another node, causes downtime [ASSISTED]
ENGINE_ACTION_MIGRATION=
# Charging clients for overage (they must also opt in) [OFF]
ENGINE_ACTION_OVERAGE_BILLING=
# Emailing a client (disk full, needs more RAM) [ASSISTED]
ENGINE_ACTION_NOTIFY_CLIENT=
# Emailing admins about a problem [AUTO]
ENGINE_ACTION_ALERT_ADMIN=
# Closing a full node to new clients (ProxmoxNode.acceptNewClients) [AUTO]
ENGINE_ACTION_STOP_SIGNUPS=
# [optional] New monthly infrastructure spend the engine may commit to per month, paise [500000 = ₹5,000]
ENGINE_SPEND_CAP_PAISE=
